#!/usr/bin/env bash
# apply-graft: graft the project's host-side pieces onto the baked
# framework tree inside the VM.
#
# Two kinds of graft, both read from /srv/project/mosaic.yaml:
#
#   plugins:        directories, attached with a bind-mount
#   project_files:  single files, attached with a symlink
#
# Plugins:
#
#     /srv/project/<plugins_root>/<destination>
#         (project root, virtiofs-mounted; plugins_root is "." for
#          Moodle 4.x or "public" for Moodle 5.x)
#                          ↓ bind-mount
#     /srv/<framework>/<plugins_root>/<destination>
#         (canonical baked path PHP traverses)
#
# On 5.x a destination may climb out of public/ with `..` (e.g.
# `../custom/toolkit` for root-level code beside the webroot); it is
# grafted the same way, as long as it stays inside /srv/<framework>.
#
# PHP's __DIR__ resolves to the bind-mount path, so
# `__DIR__/../../config.php` from a plugin file points at the
# canonical config.php in the baked tree as Moodle expects. Symlinks
# would resolve through and break that traversal — bind-mounts are
# load-bearing.
#
# Nested plugins (a sub-plugin whose destination sits inside another
# declared plugin, e.g. local/foo/subplugin/bar under local/foo) are
# NOT bound separately. Once local/foo is bound, every path beneath it
# — including the sub-plugin's host clone — is already the host
# directory, so a second bind would be redundant at best. At worst it
# is destructive: `rm -rf` on the nested destination goes straight
# through the parent's bind and deletes the host clone. Such entries
# are detected and skipped; see the plugin loop.
#
# Project files:
#
#     /srv/project/<path>  ←  symlink  ←  /srv/<framework>/<path>
#
# For files the framework expects to find relative to its own root but
# which belong to the project rather than to any one plugin — the
# canonical case being a `.env` read via $CFG->dirroot, editable by
# whoever operates the site. Nothing include()s these, so the __DIR__
# constraint above doesn't apply and a symlink is the cheaper tool: it
# survives reboot on its own, where a bind-mount would need
# re-establishing.
#
# Triggered by:
#   - apply-graft.service systemd oneshot at boot (so binds restore
#     after `mosaic down && mosaic up`);
#   - explicit start by `mosaic build` (post-bake);
#   - explicit start by `mosaic apply-graft` (when the manifest changed
#     without running a full bake), and by `mosaic sync-graft`.
#
# Idempotent: existing bind mounts under the framework tree are
# unmounted and previously-grafted files removed before re-applying, so
# a stale manifest doesn't accumulate cruft.

set -euo pipefail

# Run-context guard. apply-graft must run inside the VM as root —
# bind-mounts are kernel-level and require CAP_SYS_ADMIN.
if [ ! -f /etc/lima-guest ] && [ ! -f /etc/mosaic-guest ]; then
    echo "apply-graft: not inside a Mosaic guest" >&2
    exit 1
fi
if [ "$(id -u)" -ne 0 ]; then
    echo "apply-graft: must run as root" >&2
    exit 1
fi
command -v yq >/dev/null 2>&1 || {
    echo "apply-graft: yq not in PATH (provision step missing?)" >&2
    exit 1
}

# --- read project context ---------------------------------------------------

CFG=/srv/project/mosaic.yaml
[ -f "$CFG" ] || {
    echo "apply-graft: $CFG missing" >&2
    exit 1
}

framework=$(yq -r '.framework' "$CFG")

# plugins_root and other profile-derived values are resolved on the
# host at build time (lib.sh's profile_get handles `extends`) and
# written into .mosaic/plugin-context for the VM to source. Default
# is "." — matches Moodle 4.x; Moodle 5.x will set it to "public".
PLUGINS_ROOT="."
ctx=/srv/project/.mosaic/plugin-context
if [ -f "$ctx" ]; then
    # shellcheck disable=SC1090
    . "$ctx"
fi

# Base paths. The host project root (virtiofs-mounted at /srv/project)
# mirrors the baked framework root $fw_root, where PHP serves from.
# `plugins_root` adds a /public layer for Moodle 5.x — which makes
# $vm_base the equivalent of Moodle's $CFG->dirroot, so plugin
# destinations and project_files paths line up with dirroot on both
# 4.x and 5.x.
fw_root="/srv/$framework"
vm_base="$fw_root"
if [ "$PLUGINS_ROOT" != "." ]; then
    vm_base="$vm_base/$PLUGINS_ROOT"
fi

if [ ! -d "$vm_base" ]; then
    echo "apply-graft: $vm_base does not exist — bake hasn't run yet?" >&2
    exit 0
fi

plugin_count=$(yq -r '.plugins | length // 0' "$CFG")
[ "$plugin_count" = "null" ] && plugin_count=0
file_count=$(yq -r '.project_files | length // 0' "$CFG")
[ "$file_count" = "null" ] && file_count=0

# --- unmount stale binds ----------------------------------------------------
# Anything bind-mounted under the framework root is from a previous
# apply. That is $fw_root, not $vm_base: on 5.x a destination may climb
# out of public/ (`../custom/foo` for root-level code that isn't
# web-served), and its bind must be unwound too — otherwise the rm -rf
# in the plugin loop goes through the still-live mount and deletes the
# host clone. Sort deepest-first so nested mounts unwind cleanly (older
# releases did bind nested destinations; a VM upgraded in place may
# still have them).

while read -r mp; do
    [ -n "$mp" ] && umount "$mp" 2>/dev/null || true
done < <(awk -v base="$fw_root" 'index($5, base"/") == 1 { print $5 }' \
         /proc/self/mountinfo | sort -r)

# --- reap stale project-file symlinks ---------------------------------------
# Unlike bind-mounts, symlinks survive reboot — so an entry dropped from
# project_files would otherwise linger in the tree indefinitely (a stale
# .env still being read is exactly the kind of thing that wastes an
# afternoon). The state file records what the last run created; anything
# still pointing into the project gets removed before we re-apply.

STATE=/var/lib/mosaic/grafted-files
install -d -m 0755 "$(dirname "$STATE")"

if [ -f "$STATE" ]; then
    while read -r old; do
        [ -n "$old" ] || continue
        [ -L "$old" ] || continue
        case "$(readlink "$old")" in
            /srv/project/*) rm -f "$old" ;;
        esac
    done < "$STATE"
fi
: > "$STATE"

if [ "$plugin_count" -eq 0 ] && [ "$file_count" -eq 0 ]; then
    echo "apply-graft: nothing declared in mosaic.yaml — nothing to do"
    exit 0
fi

# --- graft plugins ----------------------------------------------------------

if [ "$plugin_count" -gt 0 ]; then
    echo "apply-graft: $plugin_count plugin(s) under $vm_base"
fi

# A destination is relative to $vm_base, and may climb out of it with
# `..` (5.x root-level code beside public/). Every check below compares
# paths as strings, so first reduce each destination to a lexically
# normalised path relative to $fw_root — its "key". The host source is
# then /srv/project/<key> and the bind target $fw_root/<key>, on 4.x
# and 5.x alike. Prints nothing if the destination is unusable: empty,
# absolute, escaping the framework root, or the root / webroot itself
# (an rm -rf there would take the whole served tree with it).
dest_key() {
    local dest=$1 abs key
    case "$dest" in ""|null|/*) return 0 ;; esac
    abs=$(realpath -ms "$vm_base/$dest")
    case "$abs" in
        "$fw_root"/*) key=${abs#"$fw_root"/} ;;
        *) return 0 ;;
    esac
    case "$PLUGINS_ROOT/" in
        "$key"/*) return 0 ;;
    esac
    printf '%s' "$key"
}

# Keys of all declared plugins, newline-separated, for the nesting
# check below. Computed once rather than inside the loop for every pair.
all_keys=$(yq -r '.plugins[].destination // ""' "$CFG" |
    while read -r d; do k=$(dest_key "$d"); [ -n "$k" ] && echo "$k"; done)

# Print the key of the declared plugin that contains key $1, if any
# (the nearest one). Empty output means $1 is top-level.
nested_in() {
    local dest=$1 best='' other
    while read -r other; do
        [ -n "$other" ] || continue
        [ "$other" = "$dest" ] && continue
        case "$dest" in
            "$other"/*)
                # Prefer the deepest ancestor so the message names the
                # immediate parent.
                if [ ${#other} -gt ${#best} ]; then best=$other; fi
                ;;
        esac
    done <<EOF
$all_keys
EOF
    printf '%s' "$best"
}

# True if any live mount point strictly under $fw_root is at, below,
# or above $1. Stale binds were unmounted above, so anything matching
# here was created by THIS run — rm -rf through it would reach the
# host. Defence in depth behind the nesting check; should never fire.
overlaps_live_mount() {
    local p=$1
    awk -v base="$fw_root" -v p="$p" '
        index($5, base"/") == 1 &&
        ($5 == p || index($5, p"/") == 1 || index(p, $5"/") == 1) { found = 1 }
        END { exit(found ? 0 : 1) }' /proc/self/mountinfo
}

i=0
while [ "$i" -lt "$plugin_count" ]; do
    dest=$(yq -r ".plugins[$i].destination" "$CFG")
    if [ -z "$dest" ] || [ "$dest" = "null" ]; then
        echo "apply-graft: plugin index $i has no 'destination' — skipping" >&2
        i=$((i + 1))
        continue
    fi

    key=$(dest_key "$dest")
    if [ -z "$key" ]; then
        echo "apply-graft: plugin destination '$dest' must resolve to a path inside $fw_root, other than the webroot itself — skipping" >&2
        i=$((i + 1))
        continue
    fi
    src="/srv/project/$key"
    dst="$fw_root/$key"

    if [ ! -d "$src" ]; then
        echo "apply-graft: source missing for '$dest': $src — bake step ran?" >&2
        i=$((i + 1))
        continue
    fi

    # Nested inside another declared plugin: the parent's bind already
    # exposes this directory at its canonical path. Binding again would
    # be redundant, and the rm -rf below would delete the host clone
    # through the parent's mount. Order-independent — the check is
    # against the manifest, not against what has been mounted so far —
    # so a child listed before its parent is still left alone.
    outer=$(nested_in "$key")
    if [ -n "$outer" ]; then
        if [ -d "/srv/project/$outer" ]; then
            echo "  = $dest  (nested in $outer; reached through its bind)"
        else
            echo "apply-graft: '$dest' is nested in '$outer', whose source is missing — it will not be reachable until $outer is cloned" >&2
        fi
        i=$((i + 1))
        continue
    fi

    if overlaps_live_mount "$dst"; then
        echo "apply-graft: $dst overlaps a bind mount created by this run — refusing to rm -rf through it; skipping '$dest'" >&2
        i=$((i + 1))
        continue
    fi

    # Replace whatever's at the destination. Mosaic's per-plugin model
    # means we own this slot — if upstream Moodle ever ships a plugin
    # at the exact same path, build's collision-check refuses the bake
    # before we get here, so this rm is safe.
    parent=$(dirname "$dst")
    install -d -m 0755 "$parent"
    if [ -e "$dst" ] || [ -L "$dst" ]; then
        rm -rf "$dst"
    fi
    install -d -m 0755 "$dst"

    mount --bind "$src" "$dst"
    echo "  + $dest  ↻ $src"

    i=$((i + 1))
done

# --- graft project files ----------------------------------------------------

if [ "$file_count" -gt 0 ]; then
    echo "apply-graft: $file_count project file(s) under $vm_base"
fi

i=0
while [ "$i" -lt "$file_count" ]; do
    rel=$(yq -r ".project_files[$i]" "$CFG")

    # Entries are paths relative to the project root. Anything absolute
    # or climbing out of it would graft from somewhere we don't own.
    case "$rel" in
        ""|null|/*|*..*)
            echo "apply-graft: invalid project_files entry '$rel' — skipping" >&2
            i=$((i + 1))
            continue
            ;;
    esac

    # Declared relative to the project root, which on 5.x is one level
    # above $vm_base (the public/ webroot). The symlink still lands
    # under $vm_base so the framework finds it relative to $CFG->dirroot.
    src="/srv/project/$rel"
    dst="$vm_base/$rel"

    if [ ! -e "$src" ]; then
        echo "apply-graft: project file missing: $src — skipping" >&2
        i=$((i + 1))
        continue
    fi

    # Only ever replace our own symlink. A real file at the destination
    # belongs to the baked framework, and silently shadowing it would be
    # a nasty surprise.
    if [ -e "$dst" ] && [ ! -L "$dst" ]; then
        echo "apply-graft: $dst exists in the framework tree — refusing to shadow it" >&2
        i=$((i + 1))
        continue
    fi

    install -d -m 0755 "$(dirname "$dst")"
    ln -sfn "$src" "$dst"
    echo "$dst" >> "$STATE"
    echo "  + $rel  → $src"

    i=$((i + 1))
done

# Bind mounts change the file paths PHP-FPM sees. Its realpath_cache
# (per worker, lasts realpath_cache_ttl seconds — 120 by default) holds
# old resolutions until cleared. try-restart so this is a no-op if FPM
# isn't running yet (fresh build, before the user starts services).
php_v=$(yq -r '.php.version' "$CFG")
systemctl try-restart "php${php_v}-fpm.service" 2>/dev/null || true

echo "apply-graft: done"
