#!/usr/bin/env bash
# in-vm: run a command inside a Lima VM at /srv/project, preserving argv
# quoting and allocating a TTY when invoked from an interactive terminal.
#
# Used as the {{prefix}} for VM-destined recipes on macOS, e.g.:
#   mosaic up        →  in-vm mosaic-tc-lms podman compose -f ...
#   mosaic db        →  in-vm mosaic-tc-lms podman exec -it ...-db-1 mariadb ...
#   mosaic install X →  in-vm mosaic-tc-lms php ... admin/cli/install.php ...
#
# Why not `limactl shell`: limactl inserts a literal `--` between the VM
# name and the user's command, which the remote bash interprets as an
# invalid option flag and bails. Going straight through ssh with the
# Lima-generated ssh.config sidesteps that entirely.
#
# Lifted near-verbatim from titus-devenv/scripts/in-vm — proven, no
# Mosaic-specific changes needed.

set -euo pipefail

if [ "$#" -lt 2 ]; then
    echo "Usage: $0 <vm> <command> [args...]" >&2
    exit 2
fi

vm="$1"; shift
lima_config="$HOME/.lima/$vm/ssh.config"
[ -f "$lima_config" ] || { echo "Lima ssh config not found: $lima_config — is the VM running?" >&2; exit 2; }

ssh_args=(-F "$lima_config")
# Allocate a TTY only for interactive sessions. -t on a pipe breaks
# output formatting in subtle ways (CR injection), so skip it there.
[ -t 0 ] && ssh_args+=(-t)

# Build a safely-quoted command string. We:
#   1. cd into the project root.
#   2. Load direnv's exports so `.envrc` (and anything it pulls in via
#      dotenv_if_exists) populates the env — direnv's hook only fires
#      on interactive shells, so `bash -c` invocations like this one
#      would otherwise miss the env.
#   3. Run the user's command with every arg safely quoted.
cmd="cd /srv/project && eval \"\$(direnv export bash 2>/dev/null)\" && "
for arg in "$@"; do
    cmd+=$(printf '%q ' "$arg")
done

exec ssh "${ssh_args[@]}" "lima-$vm" "$cmd"
