#!/usr/bin/env bash
# in-vm: run a command inside the project's guest at /srv/project,
# preserving argv quoting. This is the single exec seam every recipe,
# hook and helper goes through — and it is now a dispatcher: the actual
# transport (ssh into a Lima VM, podman exec into a distrobox container)
# lives in backends/<name>/driver exec.
#
#   in-vm <guest-name> <command> [args...]
#
# Set MOSAIC_FORWARD_AGENT=1 for commands that need the host's ssh agent
# (private-repo clones inside the guest); the driver decides how.
#
# Runs from the project directory (recipes and hooks both cd there), so
# the backend resolves from mosaic.yaml; outside a project it falls back
# to the platform default.

set -euo pipefail
. "$(dirname "$0")/lib.sh"

if [ "$#" -lt 2 ]; then
    echo "Usage: $0 <guest> <command> [args...]" >&2
    exit 2
fi

driver=$(backend_driver) || exit 1
exec "$driver" exec "$@"
