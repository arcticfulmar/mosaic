#!/usr/bin/env bash
# apply-plugins: project each plugin into the baked framework tree
# inside the VM, via per-plugin bind-mounts.
#
# Reads plugin entries from /srv/project/mosaic.yaml. For each one:
#
#     /srv/project/<framework>/<plugins_root>/<destination>
#         (host clone, virtiofs-mounted)
#                          ↓ bind-mount
#     /srv/<framework>/<plugins_root>/<destination>
#         (canonical baked path PHP traverses)
#
# PHP's __DIR__ resolves to the bind-mount path, so
# `__DIR__/../../config.php` from a plugin file points at the
# canonical config.php in the baked tree as Moodle expects. Symlinks
# would resolve through and break that traversal — bind-mounts are
# load-bearing.
#
# Triggered by:
#   - apply-plugins.service systemd oneshot at boot (so binds restore
#     after `mosaic down && mosaic up`);
#   - explicit start by `mosaic build` (post-bake);
#   - explicit start by `mosaic plugins-apply` (when the plugin set
#     changed in mosaic.yaml without running a full bake).
#
# Idempotent: any existing bind mounts under the framework tree are
# unmounted first, so a stale plugin set doesn't accumulate cruft.

set -euo pipefail

# Run-context guard. apply-plugins must run inside the VM as root —
# bind-mounts are kernel-level and require CAP_SYS_ADMIN.
if [ ! -f /etc/lima-guest ]; then
    echo "apply-plugins: not inside a Lima VM" >&2
    exit 1
fi
if [ "$(id -u)" -ne 0 ]; then
    echo "apply-plugins: must run as root" >&2
    exit 1
fi
command -v yq >/dev/null 2>&1 || {
    echo "apply-plugins: yq not in PATH (provision step missing?)" >&2
    exit 1
}

# --- read project context ---------------------------------------------------

CFG=/srv/project/mosaic.yaml
[ -f "$CFG" ] || {
    echo "apply-plugins: $CFG missing" >&2
    exit 1
}

framework=$(yq -r '.framework' "$CFG")

# plugins_root and other profile-derived values are resolved on the
# host at build time (lib.sh's profile_get handles `extends`) and
# written into .devenv/plugin-context for the VM to source. Default
# is "." — matches Moodle 4.x; Moodle 5.x will set it to "public".
PLUGINS_ROOT="."
ctx=/srv/project/.devenv/plugin-context
if [ -f "$ctx" ]; then
    # shellcheck disable=SC1090
    . "$ctx"
fi

# Source/dest base paths. Both fixed by the framework name; only the
# `plugins_root` differs per Moodle major version.
host_base="/srv/project/$framework"
vm_base="/srv/$framework"
if [ "$PLUGINS_ROOT" != "." ]; then
    host_base="$host_base/$PLUGINS_ROOT"
    vm_base="$vm_base/$PLUGINS_ROOT"
fi

if [ ! -d "$vm_base" ]; then
    echo "apply-plugins: $vm_base does not exist — bake hasn't run yet?" >&2
    exit 0
fi

# --- unmount stale binds ----------------------------------------------------
# Anything bind-mounted under $vm_base is from a previous apply. Sort
# deepest-first so nested mounts unwind cleanly (Mosaic doesn't nest
# in v1 but cheap insurance against future plugin layouts).

while read -r mp; do
    [ -n "$mp" ] && umount "$mp" 2>/dev/null || true
done < <(awk -v base="$vm_base" '$5 == base || index($5, base"/") == 1 { print $5 }' \
         /proc/self/mountinfo | sort -r)

# --- apply current plugin set ----------------------------------------------

count=$(yq -r '.plugins | length // 0' "$CFG")
[ "$count" = "null" ] && count=0

if [ "$count" -eq 0 ]; then
    echo "apply-plugins: no plugins in mosaic.yaml — nothing to do"
    exit 0
fi

echo "apply-plugins: $count plugin(s) under $vm_base"

i=0
while [ "$i" -lt "$count" ]; do
    dest=$(yq -r ".plugins[$i].destination" "$CFG")
    if [ -z "$dest" ] || [ "$dest" = "null" ]; then
        echo "apply-plugins: plugin index $i has no 'destination' — skipping" >&2
        i=$((i + 1))
        continue
    fi

    src="$host_base/$dest"
    dst="$vm_base/$dest"

    if [ ! -d "$src" ]; then
        echo "apply-plugins: source missing for '$dest': $src — bake step ran?" >&2
        i=$((i + 1))
        continue
    fi

    # Replace whatever's at the destination. Mosaic's per-plugin model
    # means we own this slot — if upstream Moodle ever ships a plugin
    # at the exact same path, build's collision-check refuses the bake
    # before we get here, so this rm is safe.
    parent=$(dirname "$dst")
    install -d -m 0755 "$parent"
    if [ -e "$dst" ] || [ -L "$dst" ]; then
        rm -rf "$dst"
    fi
    install -d -m 0755 "$dst"

    mount --bind "$src" "$dst"
    echo "  + $dest  ↻ $src"

    i=$((i + 1))
done

# Bind mounts change the file paths PHP-FPM sees. Its realpath_cache
# (per worker, lasts realpath_cache_ttl seconds — 120 by default) holds
# old resolutions until cleared. try-restart so this is a no-op if FPM
# isn't running yet (fresh build, before the user starts services).
php_v=$(yq -r '.php.version' "$CFG")
systemctl try-restart "php${php_v}-fpm.service" 2>/dev/null || true

echo "apply-plugins: done"
