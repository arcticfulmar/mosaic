#!/usr/bin/env bash
# Mosaic CLI entrypoint — the `mosaic` command on PATH.
#
# v2 shim. Two jobs:
#
#   1. Resolve MOSAIC_HOME (same rules as v1: env override for source
#      checkouts, else walk up from this script, rewriting brew Cellar
#      paths to the stable /opt/mosaic symlink so paths baked into VM
#      configs survive `brew upgrade`).
#
#   2. Generate the project's justfile. There is no monolithic tool
#      justfile any more: the shim reads `framework:` from mosaic.yaml,
#      maps it to a flavour, and writes `.mosaic/justfile` importing
#      core/core.just plus exactly one flavours/<flavour>/recipes.just.
#      A recipe that isn't loaded can't be run in the wrong project —
#      that structural guarantee replaces v1's require-framework.sh
#      guards and its hand-rolled group-filtered listing.
#
# The generated file is content-addressed, not mtime-addressed: we
# recompute the desired content on every invocation (it's three lines)
# and rewrite only when it differs. Framework changes in mosaic.yaml,
# MOSAIC_HOME moves, and flavour renames all invalidate it for free.
#
# Outside a project there is nothing to generate against, so we use a
# cached tool-only justfile under ~/.cache/mosaic/ — same shape, no
# flavour import. `set positional-arguments` lives in the generated
# root file (settings there are guaranteed to apply to every import),
# preserving v1's argv-boundary behaviour end-to-end.

set -euo pipefail

die() { printf 'mosaic: %s\n' "$*" >&2; exit 1; }

if [[ -z "${MOSAIC_HOME:-}" ]]; then
    self=$(realpath "${BASH_SOURCE[0]}")
    MOSAIC_HOME=$(cd "$(dirname "$self")/.." && pwd)

    # Rewrite brew's versioned Cellar path to the stable opt symlink —
    # see v1 bin/mosaic for the full rationale (VM configs bake this
    # path in; it must survive a brew upgrade).
    if [[ $MOSAIC_HOME =~ ^(.*)/Cellar/mosaic/[^/]+(/.*)?$ ]]; then
        MOSAIC_HOME="${BASH_REMATCH[1]}/opt/mosaic${BASH_REMATCH[2]}"
    fi

    export MOSAIC_HOME
fi

[[ -f "$MOSAIC_HOME/core/core.just" ]] ||
    die "MOSAIC_HOME does not look like a Mosaic install: $MOSAIC_HOME
mosaic: expected to find $MOSAIC_HOME/core/core.just"

command -v yq >/dev/null 2>&1 ||
    die "yq not found on PATH (it's a Mosaic dependency; brew install yq)"

# Env selection: `--env <env>` (or `--env=<env>`) right before or right
# after the recipe name, else $MOSAIC_ENV. The flag wins, and an empty
# one (`--env ''`) means no env even when $MOSAIC_ENV is set. Only those
# two positions: anything later belongs to the recipe (`mosaic composer
# … --env x` reaches composer untouched). An env merges mosaic.<env>.yaml
# over mosaic.yaml — scripts/manifest.sh.
env_flag=0
case ${1:-} in
    --env)   [[ $# -ge 2 ]] || die "--env needs a name"
             MOSAIC_ENV=$2; env_flag=1; shift 2 ;;
    --env=*) MOSAIC_ENV=${1#--env=}; env_flag=1; shift ;;
esac
if [[ $env_flag == 0 && $# -ge 2 && $1 != -* ]]; then
    recipe=$1
    case $2 in
        --env)   [[ $# -ge 3 ]] || die "--env needs a name"
                 MOSAIC_ENV=$3; env_flag=1; shift 3 ;;
        --env=*) MOSAIC_ENV=${2#--env=}; env_flag=1; shift 2 ;;
    esac
    [[ $env_flag == 1 ]] && set -- "$recipe" ${1+"$@"}
fi
MOSAIC_ENV=${MOSAIC_ENV:-}

# Walk up from the user's cwd looking for mosaic.yaml, so recipes work
# from any subfolder of a project. Stop at / or $HOME — a stray
# mosaic.yaml above the home directory would be more surprising than
# failing fast.
PROJECT_DIR=""
dir="$PWD"
while [[ -d "$dir" ]]; do
    if [[ -f "$dir/mosaic.yaml" ]]; then
        PROJECT_DIR="$dir"
        break
    fi
    [[ "$dir" == "/" || "$dir" == "$HOME" ]] && break
    dir=$(dirname "$dir")
done

if [[ -n "$PROJECT_DIR" ]]; then
    # With an env, merge once here and hand every recipe the result;
    # without one, read mosaic.yaml as before.
    if [[ -n $MOSAIC_ENV ]]; then
        MOSAIC_MANIFEST=$("$MOSAIC_HOME/scripts/manifest.sh" "$MOSAIC_ENV" "$PROJECT_DIR") || exit 1
        export MOSAIC_ENV MOSAIC_MANIFEST
    else
        unset MOSAIC_ENV MOSAIC_MANIFEST
    fi

    # The guest's env: .mosaic/manifest.yaml (+ manifest.env naming it)
    # is the merged manifest the guest was last set up with, which a
    # Lima guest's boot-time apply-graft reads. Only the commands that
    # set the guest up change it; any other command running with a
    # different env (or none) leaves it alone and says so, because a
    # forgotten --env in a kassi rebuilds on the base ports.
    applied=$PROJECT_DIR/.mosaic/manifest.yaml
    applied_env=''
    [[ -f $applied ]] && applied_env=$(cat "$PROJECT_DIR/.mosaic/manifest.env" 2>/dev/null || true)
    case ${1:-} in
        build|up|reload-web) sets_guest=1 ;;
        *)                   sets_guest=0 ;;
    esac
    if [[ -n $applied_env && $applied_env != "${MOSAIC_ENV:-}" ]]; then
        now="${MOSAIC_ENV:+--env $MOSAIC_ENV}"
        printf 'mosaic: warning: the guest was set up with --env %s; this command uses %s%s\n' \
            "$applied_env" "${now:-mosaic.yaml alone}" \
            "$([[ $sets_guest == 1 ]] && echo ' and switches the guest to it' || true)" >&2
        printf 'mosaic:          (add --env %s, or set MOSAIC_ENV=%s, to keep it)\n' \
            "$applied_env" "$applied_env" >&2
        # Switching the guest on a terminal is a question, not a warning
        # scrolling past (a forgotten --env in a kassi rebuilds it on
        # the base ports). Scripts and CI keep the warning and go on.
        if [[ $sets_guest == 1 && -t 0 ]]; then
            printf 'mosaic: switch the guest from --env %s to %s? [y/N]: ' \
                "$applied_env" "${now:-mosaic.yaml alone}" >&2
            answer=''
            IFS= read -r answer || true
            case $answer in
                y|Y|yes|Yes|YES) ;;
                *) die "left the guest on --env $applied_env; nothing run" ;;
            esac
        fi
    fi
    if [[ $sets_guest == 1 ]]; then
        if [[ -n ${MOSAIC_ENV:-} ]]; then
            cp "$MOSAIC_MANIFEST" "$applied"
            printf '%s\n' "$MOSAIC_ENV" > "$PROJECT_DIR/.mosaic/manifest.env"
        else
            rm -f "$applied" "$PROJECT_DIR/.mosaic/manifest.env"
        fi
    fi
    framework=$(yq -r '.framework // ""' "${MOSAIC_MANIFEST:-$PROJECT_DIR/mosaic.yaml}")

    # framework → flavour. Hardcoded until flavour.yaml lands (the
    # flavour-architecture doc's `extends:` model); keep this list in
    # sync with flavours/*/.
    case "$framework" in
        moodle|workplace|totara) flavour=moodle ;;
        laravel)                 flavour=laravel ;;
        "") die "no 'framework:' key in $PROJECT_DIR/mosaic.yaml" ;;
        *)  die "unknown framework '$framework' in $PROJECT_DIR/mosaic.yaml (known: moodle, workplace, totara, laravel)" ;;
    esac

    JUSTFILE="$PROJECT_DIR/.mosaic/justfile"
    WORKDIR="$PROJECT_DIR"
    content="# Generated by mosaic from mosaic.yaml — do not edit; regenerated on every run.
set positional-arguments
import '$MOSAIC_HOME/core/core.just'
import '$MOSAIC_HOME/flavours/$flavour/recipes.just'

# just takes the default recipe from the root file only — imports
# don't contribute one. _default is hidden from the listing.
_default: _list
"
else
    [[ $env_flag == 0 ]] || die "--env needs a project (no mosaic.yaml here or above)"
    unset MOSAIC_ENV MOSAIC_MANIFEST
    JUSTFILE="${XDG_CACHE_HOME:-$HOME/.cache}/mosaic/tool.just"
    WORKDIR="$PWD"
    content="# Generated by mosaic (no project context) — do not edit.
set positional-arguments
import '$MOSAIC_HOME/core/core.just'

_default: _list
"
fi

# Rewrite only on content change; atomic so a parallel `mosaic` never
# sees a half-written file. Both sides go through $() so trailing-
# newline stripping is symmetric.
if [[ "$(cat "$JUSTFILE" 2>/dev/null || true)" != "$(printf '%s' "$content")" ]]; then
    mkdir -p "$(dirname "$JUSTFILE")"
    tmp=$(mktemp "$(dirname "$JUSTFILE")/.justfile.XXXXXX")
    printf '%s' "$content" > "$tmp"
    mv "$tmp" "$JUSTFILE"
fi

exec just \
    --justfile "$JUSTFILE" \
    --working-directory "$WORKDIR" \
    "$@"
